{
	"name": "telegram-fxd-vip",
	"version": "1.0.0",
	"private": true,
	"description": "Telegram message capture for the FXD Trades | VIP group",
	"main": "dist/listener.js",
	"scripts": {
		"dev": "tsx watch src/listener.ts",
		"dev:once": "tsx src/listener.ts",
		"fetch:history": "tsx src/fetchHistory.ts",
		"export:backtest": "tsx src/exportBacktestSignals.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/listener.js",
		"typecheck": "tsc --noEmit",
		"pm2:start": "npm run build && pm2 start ecosystem.config.js",
		"pm2:stop": "pm2 stop telegram-fxd-vip",
		"pm2:restart": "npm run build && pm2 restart telegram-fxd-vip",
		"pm2:logs": "pm2 logs telegram-fxd-vip",
		"pm2:delete": "pm2 delete telegram-fxd-vip"
	},
	"dependencies": {
		"dotenv": "^16.4.5",
		"telegram": "^2.26.22"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"pm2": "^7.0.4",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	},
	"engines": {
		"node": ">=18"
	}
}
