TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
# Optional: pre-saved string session. If empty, first run will prompt login and persist session file.
TELEGRAM_STRING_SESSION=
# Optional: pre-fill login prompts
TELEGRAM_PHONE_NUMBER=
# Optional: one-time Telegram OTP code for non-interactive login
TELEGRAM_LOGIN_CODE=
TELEGRAM_PASSWORD=
# File used to persist session after first login
TELEGRAM_SESSION_FILE_PATH=./data/telegram.session
# Group to listen to (name must match exactly, or use the numeric chat id once known)
TARGET_GROUP_NAME=FXD Trades | VIP
# Where captured messages are appended as JSON lines
DATA_FILE_PATH=./data/messages.jsonl
# Port the signal API server listens on. The MQL5 EA polls
# GET http(s)://<your-server>/api/signals?since=<seq> against this.
API_PORT=8787
